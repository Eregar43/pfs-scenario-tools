  "version": "#{VERSION}#",
  "library": "false",
  "manifestPlusVersion": "1.2.0",
  "compatibility": {
    "minimum": 14,
    "verified": "14.365"
  },
  "authors": [
    {
      "name": "Eregar",
      "url": "https://github.com/Eregar43",
      "discord": "eregark"
    }
  ],
  "relationships": {
    "systems": [
      { "id": "pf2e", "type": "system" }
    ]
  },
  "esmodules": [
    "dist/pfs-scenario-tools.js"
  ],
