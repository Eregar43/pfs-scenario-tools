# Node
node_modules/

# Bauergebnis. Es liegt bewusst im Repo-Ordner statt in einem Zielverzeichnis:
# der Bind-Mount bildet diesen Ordner auf Foundrys Data/modules/ ab, Foundry
# sieht den Build also sofort. Versioniert wird er trotzdem nicht — die
# Release-Pipeline baut selbst.
dist/

# Release-Artefakt
module.zip

# Arbeitsmaterial, niemals Teil des Moduls: die Szenario-PDFs sind kommerzielle
# Paizo-Produkte, und die Referenzjournale bestehen aus deren Text.
#
# Die Schraegstriche am Anfang sind noetig: ein Muster ohne ihn greift auf
# jeder Ebene, `pdf/` haette also auch `src/pdf/` verschluckt.
/pdf/
/referenz/
/out/
/_reference/
